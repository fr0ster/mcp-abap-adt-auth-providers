# Test configuration template for auth-providers integration tests
# Copy this file to test-config.yaml and fill in real values
# test-config.yaml is in .gitignore and should not be committed
#
# Integration tests use this config to:
# - Load service keys and session files
# - Test all provider scenarios (AuthorizationCodeProvider, ClientCredentialsProvider)
#
# Test scenarios covered:
# 1. Only service key (no session) - provider should login/authenticate
# 2. Service key + fresh session - provider should use token from session
# 3. Service key + expired session - provider should refresh token
# 4. Service key + expired session + expired refresh token - provider should re-authenticate

# Destination name (used for service key file: <destination>.json and session file: <destination>.env)
# Example: "trial" -> looks for trial.json and trial.env
destination: <TEST_DESTINATION>  # ⚠️ UPDATE: Replace with your destination name (e.g., "trial", "mcp")

# Optional: Destination directory (base directory for service keys and sessions)
# If not specified, uses default platform paths:
#   Unix: ~/.config/mcp-abap-adt
#   Windows: %USERPROFILE%\Documents\mcp-abap-adt
# Uncomment and set if you need a custom path:
# destination_dir: ~/.config/mcp-abap-adt

# Optional: any session file for the live auth tests (absolute, ~/..., or
# relative to the project root). It need not be named after the destination.
# Order: MCP_ABAP_ADT_SESSION_FILE (env) > session_path > <destination_dir>/sessions/<destination>.env
# The tests copy it to a temporary directory and never write to it.
# session_path: ~/.config/mcp-abap-adt/sessions/mdd.env

# Optional: allow tests that open a browser for a person to log in.
# Off by default, so a plain `npm test` never waits for a login.
# MCP_ABAP_ADT_INTERACTIVE=1 enables it for a single run.
# interactive_login: true
