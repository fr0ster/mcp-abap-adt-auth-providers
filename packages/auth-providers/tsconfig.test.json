{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./.test-build",
    "rootDir": "./src",
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmitOnError": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.typecheck.ts"
  ],
  "files": [
    "src/__tests__/runner/runTests.test.ts"
  ]
}
