{
  "name": "@mcp-abap-adt/auth-providers",
  "version": "8.0.1",
  "description": "Every IAuthProvider for SAP ABAP ADT: the credentials a process delegates to, and the token providers behind them",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "COPYING"
  ],
  "keywords": [
    "abap",
    "sap",
    "adt",
    "jwt",
    "authentication",
    "token",
    "provider",
    "authorization_code",
    "client_credentials",
    "mcp",
    "abap-adt"
  ],
  "author": "Oleksii Kyslytsia <oleksij.kyslytsja@gmail.com>",
  "license": "LGPL-3.0-only",
  "homepage": "https://github.com/fr0ster/mcp-abap-adt-auth-providers#readme",
  "bugs": {
    "url": "https://github.com/fr0ster/mcp-abap-adt-auth-providers/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr0ster/mcp-abap-adt-auth-providers.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "chrono": "./tools/version-stats.sh",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "lint": "biome check --write src tools/remove.mjs tools/run-tests.mjs tools/node-test-arguments.mjs tools/node-test-arguments.d.mts",
    "lint:check": "biome check --error-on-warnings src tools/remove.mjs tools/run-tests.mjs tools/node-test-arguments.mjs tools/node-test-arguments.d.mts",
    "format": "biome format --write src",
    "build": "npm run --silent clean && biome check src --diagnostic-level=error && tsc -p tsconfig.build.json",
    "build:fast": "tsc -p tsconfig.build.json",
    "test": "npm run --silent test:build && node tools/run-tests.mjs",
    "test:build": "node tools/remove.mjs .test-build && tsc -p tsconfig.test.json",
    "test:file": "npm run --silent test:build && node tools/run-tests.mjs",
    "test:check": "tsc --noEmit",
    "test:shape": "npm run --silent test:build && node tools/run-tests.mjs .test-build/__tests__/shapeCheck.test.js",
    "docs:tables": "npm run test:file -- --env WRITE_README_TABLES=1 .test-build/__tests__/readmeRefusalTables.test.js",
    "prepublishOnly": "npm run build && npm run test:shape",
    "stand:up": "tests/stand/up.sh",
    "stand:down": "tests/stand/down.sh",
    "test:stand": "tests/stand/run.sh",
    "test:xsuaa": "tests/xsuaa/run.sh"
  },
  "engines": {
    "node": "^22 || ^24 || ^26"
  },
  "dependencies": {
    "@mcp-abap-adt/auth-errors": "^3.0.1",
    "@mcp-abap-adt/interfaces-auth": "^8.0.1",
    "@mcp-abap-adt/interfaces-auth-sap": "^3.5.0",
    "@mcp-abap-adt/interfaces-utils": "^1.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "axios": "^1.13.5",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@mcp-abap-adt/auth-mocks": "^0.4.0",
    "@mcp-abap-adt/auth-stores": "^5.0.0",
    "@mcp-abap-adt/logger": "^0.4.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.2.3",
    "js-yaml": "^4.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "unrs-resolver": false
  }
}
