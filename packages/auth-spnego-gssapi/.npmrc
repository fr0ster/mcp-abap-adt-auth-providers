# Ensure package-lock.json is always generated
package-lock=true
save-exact=false
legacy-peer-deps=true
audit=false
fund=false
loglevel=error
progress=false
install-strategy=nested
prefer-dedupe=false
prefer-online=true

# Install scripts run only for the packages package.json's allowScripts names
# (kerberos alone); any other dependency with an install script fails the
# install instead of running it. --ignore-scripts still overrides this.
strict-allow-scripts=true
