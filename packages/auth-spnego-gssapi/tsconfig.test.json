  "compilerOptions": {
    "outDir": "./.test-build",
    "rootDir": "./src",
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmitOnError": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
