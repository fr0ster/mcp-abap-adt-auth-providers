# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Test coverage
coverage/

# Logs
*.log
npm-debug.log*

# Environment files
.env
*.env
!*.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Package files
*.tgz
*.tar.gz

# Temporary files
tmp/
temp/

# Test configuration (contains sensitive data)
packages/auth-providers/tests/test-config.yaml

# Git worktrees
.worktrees/

# Superpowers scratch (ledger, briefs, review packages)
.superpowers/

# XSUAA trial checks: service-key secrets and the locally generated IdP key
packages/auth-providers/tests/xsuaa/.local/

# A service key once lived here; keep keys out of the repo
mcp.json
*service-key*.json

# Private keys and certificate bundles stay out of the repository.
*.key
*.pfx
*.p12
# Exceptions, file by file: throwaway stand fixtures, trusted by nothing but
# the local provider stand (see their READMEs). Never add a real key here.
!packages/auth-providers/tests/stand/uaa/idp/idp.key
!packages/auth-providers/tests/stand/keycloak/tls/server.key
!packages/auth-providers/tests/stand/keycloak/tls/client-a.key
!packages/auth-providers/tests/stand/keycloak/tls/client-b.key
!packages/auth-providers/tests/stand/keycloak/tls/jwt.key
# Unit-test certificate fixtures: generated for the tests, trusted by nothing.
!packages/auth-providers/src/__tests__/fixtures/certificates/client.key
!packages/auth-providers/src/__tests__/fixtures/certificates/client-encrypted.key
!packages/auth-providers/src/__tests__/fixtures/certificates/other.key
!packages/auth-providers/src/__tests__/fixtures/certificates/client.pfx
!packages/auth-providers/src/__tests__/fixtures/certificates/client-chain.pfx

# A service key is a secret: never in the repository
sk.json
*service-key*.json
