{
  "realm": "test",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "users": [
    {
      "username": "tester",
      "enabled": true,
      "emailVerified": true,
      "email": "tester@example.com",
      "firstName": "Test",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "tester", "temporary": false }]
    }
  ],
  "clients": [
    {
      "clientId": "oidc-password",
      "secret": "secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "oidc-browser",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "consentRequired": false,
      "redirectUris": ["http://localhost/callback"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "oidc-device",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "consentRequired": false,
      "attributes": { "oauth2.device.authorization.grant.enabled": "true" }
    },
    {
      "clientId": "te-subject",
      "secret": "secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience te-requester",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "te-requester",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "te-requester",
      "secret": "secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": { "standard.token.exchange.enabled": "true" }
    }
  ]
}
