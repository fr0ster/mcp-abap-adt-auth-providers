      "description": "The CERTRULE analogue: the presented certificate's CN names the user",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "direct-grant-auth-x509-username",
