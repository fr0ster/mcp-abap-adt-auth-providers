# Rendered by up.sh into .generated/config/uaa.yml. @@…@@ placeholders are
# replaced with keys generated on first run; nothing secret is committed.
issuer:
  uri: http://localhost:@@PORT@@/uaa

jwt:
  token:
    policy:
      activeKeyId: key-1
      keys:
        key-1:
          signingAlg: RS256
          signingKey: |
@@JWT_KEY@@
    refresh:
      format: opaque

login:
  # The SAML service provider entity ID: the Audience a bearer assertion must name.
  entityID: uaa-sp
  saml:
    activeKeyId: sp-key
    keys:
      sp-key:
        key: |
@@SP_KEY@@
        certificate: |
@@SP_CERT@@
    providers:
      # The asserting party. Its metadata carries the certificate the tests sign
      # with, so UAA verifies the signature exactly as it would a real IdP's.
      test-idp:
        idpMetadata: '@@IDP_METADATA@@'
        nameID: urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified
        assertionConsumerIndex: 0
        metadataTrustCheck: false
        showSamlLoginLink: false
        addShadowUserOnLogin: true

oauth:
  user:
    authorities: [openid, uaa.user]
  clients:
    # May spend refresh tokens: UAA issues one with the saml2-bearer token.
    saml_rt:
      id: saml_rt
      secret: secret
      authorized-grant-types: 'urn:ietf:params:oauth:grant-type:saml2-bearer,refresh_token'
      scope: 'openid,uaa.user'
      authorities: uaa.none
      autoapprove: 'true'
      allowedproviders: [test-idp]
    # May not: UAA issues no refresh token, and the provider must log in again.
    saml_nort:
      id: saml_nort
      secret: secret
      authorized-grant-types: 'urn:ietf:params:oauth:grant-type:saml2-bearer'
      scope: 'openid,uaa.user'
      authorities: uaa.none
      autoapprove: 'true'
      allowedproviders: [test-idp]
