{
  "name": "mcp-abap-adt-auth-providers-workspace",
  "private": true,
  "license": "LGPL-3.0-only",
  "publishOrder": ["packages/auth-spnego-gssapi", "packages/auth-providers"],
  "scripts": {
    "clean": "node tools/each-package.js run clean",
    "lint": "node tools/each-package.js run lint",
    "lint:check": "node tools/each-package.js run lint:check",
    "build": "node tools/each-package.js run build",
    "test": "node tools/each-package.js test",
    "test:check": "node tools/each-package.js run test:check",
    "test:shape": "node tools/each-package.js run --if-present test:shape",
    "test:stand": "node tools/each-package.js run --if-present test:stand",
    "stand:up": "node tools/each-package.js run --if-present stand:up",
    "stand:down": "node tools/each-package.js run --if-present stand:down",
    "check": "npm run build && npm run test:check && npm run lint:check && npm run test && npm run test:shape && npm run check:packed && npm run check:publish",
    "check:packed": "node tools/check-packed.js",
    "check:publish": "node tools/test-publish-changed.js",
    "release:publish": "node tools/publish-changed.js",
    "install:packages": "node tools/each-package.js ci --ignore-scripts"
  },
  "engines": {
    "node": "^22 || ^24 || ^26"
  },
  "devDependencies": {
    "semver": "^7.8.5"
  }
}
